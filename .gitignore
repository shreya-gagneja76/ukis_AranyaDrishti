/data/processed/**/*.tif
/data/processed/**/*.tiff
/data/processed/**/*.gpkg
/data/processed/**/*.gpkg-wal
/data/processed/**/*.gpkg-shm
/data/processed/**/*.zip

# Temporary files and logs
*.tmp
*.log

# Temporary GeoPackage spatial-index files
*.tmp_rtree_*
