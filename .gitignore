# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets and environment files
.env
.env.*
!.env.example

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw downloaded datasets
/data/raw/

